<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EnglishWordbookInstaller</AssemblyName>
    <RootNamespace>EnglishWordbookInstaller</RootNamespace>
    <ApplicationIcon>..\EnglishWordbook\assets\EnglishWordbook.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\EnglishWordbook.exe" LogicalName="EnglishWordbookInstaller.payload.EnglishWordbook.exe" />
  </ItemGroup>
</Project>
